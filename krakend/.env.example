# Copy this file to .env locally and replace the placeholders.
# Never commit the copied .env file or the real API token.
# KrakenD reaches the Compose service by its service name.
JELLYFIN_BASE_URL=http://jellyfin:8096
# Create this token in Jellyfin after its first-run setup.
JELLYFIN_API_KEY=replace-with-a-local-jellyfin-api-key
